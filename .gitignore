# Regenerable caches (make docs)
.cache/
docs/wiki.tmp/
docs/wiki/_media/

# Machine-specific
.hub.env
tlconfig.lua

.DS_Store
__pycache__/

# Probe/run output (large; contains local paths and Steam IDs)
plans/**/*.log
plans/**/probe_*.csv
tmp/

# Mod Hub upload: the game cooks each mod into these (through the staging symlink) and deletes them after
mods/*/.cooked_*/

# Third-party code (other authors' mods): never pushed to this repo. Notes in plans/<id>/ stay tracked.
# A separate private repo (git dir .forks-git/, same working tree) backs these paths up.
.forks-git/
forks/
mods/square_opt_*/
mods/square_aat_perftest/
plans/*/original/
plans/*/*.log

# Organic Towns Name lab data: holds the game's own town-name lists (game content, not ours); regenerate with
# uv run plans/square_organic_towns/names/export_names.py (data.json: the site's name lab; data.js: the old page)
plans/square_organic_towns/names/data.json
plans/square_organic_towns/names/data.js

# Gallery slides: build output of make shots (plans/<id>/shots/ captures + branding/shots.js). Content-hashed names,
# so every re-render added a new set to history. They stay on disk for the Hub upload and make modio.
mods/*/_metadata/[0-9]-*.png
mods/*/_metadata/[0-9][0-9]-*.png
