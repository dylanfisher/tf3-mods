recordDef = true

-- SQPERF types for Teal callers of content/sqperf/square_better_minimap.lua. Generated by tools/sqperf_sync.py
-- from tools/sqperf/sqperf_types.d.tl: edit the template, then `make sqperf-sync`.
-- Global names carry the mod's prefix (SquareBetterMinimap): globals are shared by all loaded mods.
-- Usage: local sqperf = ug_require "square_better_minimap::/sqperf/square_better_minimap.lua" as SquareBetterMinimapSqPerf
-- API: plans/sqperf/README.md.

global record SquareBetterMinimapSqPerfOptions
	mod : string
	ctx : string
	timed : boolean
	slowMs : number
	paramKey : string
	enabled : boolean
	gate : function() : boolean
	first : {string}
	initMs : number
	now : function() : number
end

global record SquareBetterMinimapSqPerfInst
	mod : string
	ctx : string
	timed : boolean
	on : boolean
	slowMs : number
	start : function(self : SquareBetterMinimapSqPerfInst) : number
	stop : function(self : SquareBetterMinimapSqPerfInst, name : string, t0 : number) : number
	hit : function(self : SquareBetterMinimapSqPerfInst, name : string)
	count : function(self : SquareBetterMinimapSqPerfInst, name : string, n? : integer)
	-- detail: appended string, or a string.format pattern with its args (formatted only when logged)
	phase : function(self : SquareBetterMinimapSqPerfInst, name : string, t0 : number, detail? : string, ...: any) : number
	wrap : function<F>(self : SquareBetterMinimapSqPerfInst, name : string, fn : F) : F
end

global record SquareBetterMinimapSqPerf
	VERSION : integer
	GUI_SLOW_MS : number
	SIM_SLOW_MS : number
	RATE_MS : number
	WINDOW_MS : number
	INIT_LOG_MS : number
	vm : string
	new : function(opts : SquareBetterMinimapSqPerfOptions) : SquareBetterMinimapSqPerfInst
	MASTER_MOD : string
	PARAM_KEY : string
	-- all: getModParams() or runFn's allModParams; key defaults to PARAM_KEY ("sqperf_log")
	debugOn : function(all : any, mod : string, key? : string) : boolean
	readParam : function(mod : string, key? : string) : boolean
end

recordDef = false
