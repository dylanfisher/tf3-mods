---
import ThemeToggle from "./ThemeToggle.astro";
---
<header class="border-b border-border bg-background/90 backdrop-blur supports-[backdrop-filter]:bg-background/75 sticky top-0 z-40">
  <div class="mx-auto flex h-header max-w-wide items-center justify-between gap-4 px-4">
    <a href="/" class="flex items-baseline gap-1.5 font-semibold tracking-tight hover:text-brand-text">
      <span class="inline-block size-3 translate-y-px rounded-[3px] bg-brand" aria-hidden="true"></span>
      square <span class="font-normal text-muted-foreground">· TF3 mods</span>
    </a>
    <ThemeToggle />
  </div>
</header>
