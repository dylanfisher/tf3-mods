---
// The mod's cover (_metadata/0.png through the media build), or generated title art (TitleArt, its second color the
// --mod-accent in scope) when it has none.
import type { ModInfo } from "@/lib/mods";
import TitleArt from "./TitleArt";
interface Props { mod: ModInfo; size?: "thumb" | "full"; class?: string; eager?: boolean }
const { mod, size = "thumb", class: cls, eager = false } = Astro.props;
const img = mod.cover?.[size];
---
{img ? (
  <img
    src={img.url}
    width={img.width}
    height={img.height}
    alt={`${mod.name} cover`}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    class:list={["aspect-video h-auto w-full bg-chip object-cover", cls]}
  />
) : (
  <TitleArt title={mod.name} label={`${mod.name} (no cover yet)`} className={["aspect-video", cls].filter(Boolean).join(" ")} />
)}
