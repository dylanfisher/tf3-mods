---
// Cycles the theme: system -> light -> dark, through src/lib/theme.ts (setTheme); shows the current mode, also when
// something else changed it (a #theme= link in the Name lab).
import { buttonVariants } from "@/components/ui/button";
---
<button
  type="button"
  data-theme-toggle
  class={buttonVariants({ variant: "ghost", size: "icon-sm" })}
  aria-label="Theme: system"
  title="Theme: system"
>
  <svg data-icon="system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
  <svg data-icon="light" class="hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  <svg data-icon="dark" class="hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z"/></svg>
</button>
<script>
  import { currentTheme, setTheme, THEME_EVENT, THEME_MODES, type ThemeMode } from "@/lib/theme";
  function show(btn: HTMLElement, mode: ThemeMode) {
    btn.querySelectorAll<SVGElement>("[data-icon]").forEach((s) => s.classList.toggle("hidden", s.dataset.icon !== mode));
    btn.setAttribute("aria-label", `Theme: ${mode}`);
    btn.title = `Theme: ${mode}`;
  }
  document.querySelectorAll<HTMLElement>("[data-theme-toggle]").forEach((btn) => {
    show(btn, currentTheme());
    btn.addEventListener("click", () => setTheme(THEME_MODES[(THEME_MODES.indexOf(currentTheme()) + 1) % THEME_MODES.length]));
    document.addEventListener(THEME_EVENT, () => show(btn, currentTheme()));
  });
</script>
