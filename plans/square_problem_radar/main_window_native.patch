+-- Closing punctuation never starts a tooltip line (CLAUDE.md "Tooltips": ja / zh).
+local CLOSING : {string : boolean} = {
+	["、"] = true, ["。"] = true, ["，"] = true, ["．"] = true, ["："] = true, ["；"] = true, ["！"] = true,
+	["？"] = true, ["）"] = true, ["」"] = true, ["』"] = true, ["】"] = true, ["》"] = true, ["〉"] = true,
