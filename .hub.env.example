# Copy to .hub.env (gitignored). All values are optional on macOS + Steam;
# tools auto-detect paths when unset.
# TF3_INSTALL=~/Library/Application Support/Steam/steamapps/common/Transport Fever 3
# TF3_USERDATA=~/Library/Application Support/Steam/userdata/<steamid>/3493540/local
# TF3_MODIO=~/Library/Application Support/mod.io
# Default author for `make new-mod`:
# TF3_AUTHOR=square
